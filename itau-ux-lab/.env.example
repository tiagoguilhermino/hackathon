# Opcional: as chaves do projeto já estão em src/lib/llm/keys.ts. Copie para .env.local
# só para usar outra chave (ela tem prioridade). Nunca faça commit do .env.local.
GROQ_API_KEY=
# live | mock (sem definir: live se houver chave)
LLM_MODE=
# Modelo Groq usado pelos 3 agentes (strict JSON schema: openai/gpt-oss-120b, openai/gpt-oss-20b)
LLM_MODEL=openai/gpt-oss-120b
# Latência do modo mock (ms)
MOCK_LLM_LATENCY_MS=350
