# Copie para backend/.env e preencha. O .env está no .gitignore: nunca faça commit dele,
# nunca cole a chave no código, no chat ou no vídeo.
ANTHROPIC_API_KEY=

# Opcionais (valores padrão entre parênteses)
# VILA_MODELO=claude-opus-5     # modelo da vila
# VILA_ESFORCO=medium           # low | medium | high; congelar junto com o prompt na H6
# VILA_PARALELO=12              # chamadas simultâneas
# VILA_TENTATIVAS=3             # novas tentativas automáticas do SDK em erro temporário
# VILA_FALLBACK=1               # se a IA recusar, a API refaz no modelo reserva
# VILA_MODO_DEMO=0              # 1 = carrega resultados/demo.json sem chamar a API
# VILA_TRUSTSTORE=1             # usa os certificados do sistema (redes com proxy)
