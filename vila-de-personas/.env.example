# Copie este arquivo para .env e cole a chave da Groq depois do sinal de igual.
# O .env não vai para o GitHub (está no .gitignore).
# Nunca cole a chave no código, no chat, num print ou no vídeo.
GROQ_API_KEY=

# Opcionais (já são o padrão do motor). O único modelo da Groq que lê imagem hoje é este,
# e ele está em prévia: se sair do ar, use "Carregar resultado salvo" no painel.
VILA_MODELO=qwen/qwen3.8-27b
VILA_ESFORCO=medium
