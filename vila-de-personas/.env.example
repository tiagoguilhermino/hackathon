# Copie este arquivo para .env e cole a chave da Groq depois do sinal de igual.
# O .env não vai para o GitHub (está no .gitignore).
# Nunca cole a chave no código, no chat, num print ou no vídeo.
GROQ_API_KEY=

# Opcionais: estes já são os padrões do motor, ajustados ao plano GRATUITO da Groq, que limita o
# modelo a 1.000 tokens de resposta por minuto e recusa pedidos maiores. Por isso: sem raciocínio,
# teto de 1.000 tokens e uma chamada de cada vez (cerca de 1 tentativa por minuto).
# O único modelo da Groq que lê imagem hoje é este, e ele está em prévia: se sair do ar, use
# "Carregar resultado salvo" no painel.
VILA_MODELO=qwen/qwen3.8-27b
VILA_ESFORCO=none
VILA_TEMPERATURA=0.6
VILA_MAX_TOKENS=1000
VILA_PARALELO=1
# No plano pago da Groq (Dev Tier) dá para usar, por exemplo, VILA_ESFORCO=medium,
# VILA_MAX_TOKENS=3000 e VILA_PARALELO=4. Mudar isso muda os resultados: registre no vila/README.md.
